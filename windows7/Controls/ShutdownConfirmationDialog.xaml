<UserControl x:Class="ChromeOS.Controls.ShutdownConfirmationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560"
             Height="478"
             Background="Transparent">
    <Grid>
        <Border Background="#2C2C2E"
                CornerRadius="24"
                Padding="40">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.8"/>
            </Border.Effect>

            <StackPanel>
                <!-- Icon -->
                <Grid Width="100" Height="100" Margin="0,16,0,16" HorizontalAlignment="Center">
                    <Ellipse Width="100" Height="100" Fill="#EA4335" Opacity="0.12"/>
                    <Ellipse Width="70" Height="70" Stroke="#EA4335" StrokeThickness="2" Opacity="0.4" StrokeDashArray="5,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="IconRotate" Angle="0" CenterX="35" CenterY="35"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Path Data="M 20 20 L 20 55 A 25 25 0 0 1 70 55 L 70 20"
                          Stroke="#EA4335"
                          StrokeThickness="5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top" Margin="6,-4,0,0"/>
                    <Ellipse Width="14" Height="14" Fill="#EA4335" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Title -->
                <TextBlock Text="确认关机"
                           Foreground="#FFFFFF"
                           FontSize="30"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <!-- Message -->
                <TextBlock Text="您确定要关机吗？"
                           Foreground="#E8EAED"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="所有未保存的数据将会丢失"
                           Foreground="#98989D"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Spacer -->
                <Rectangle Height="1" Fill="#3A3A3C" Margin="0,0,0,32"/>

                <!-- Buttons -->
                <Grid Height="76" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="取消"
                            Height="52"
                            Width="200"
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="#E8EAED"
                            Background="#3A3A3C"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="16"
                                        Padding="32,16"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="16"
                                                      TextElement.FontWeight="Medium"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#454548"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#4E4E51"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ShutdownButton"
                            Grid.Column="2"
                            Content="关机"
                            Height="52"
                            Width="200"
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="#FFFFFF"
                            Background="#EA4335"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="16"
                                        Padding="32,16"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="16"
                                                      TextElement.FontWeight="Medium"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F15858"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#D63939"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>