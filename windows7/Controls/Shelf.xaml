<UserControl x:Class="ChromeOS.Controls.Shelf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChromeOS.Controls">
    <!-- macOS Dock Style Container -->
    <Grid>
        <!-- Main Dock Container - Centered at bottom -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="6,4">
            <Border Background="{StaticResource MacOSShelfBackground}"
                    CornerRadius="18"
                    BorderBrush="{StaticResource MacOSShelfBorder}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left side - Launcher and pinned apps -->
                    <StackPanel x:Name="PinnedApps" 
                                Grid.Column="0"
                                Orientation="Horizontal" 
                                Margin="4,0">
                        <!-- Launcher button -->
                        <Button Style="{StaticResource DockIconButtonStyle}" 
                                Click="OnLauncherClick"
                                ToolTip="Launcher">
                            <Grid Width="36" Height="36">
                                <Ellipse Width="36" Height="36">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#EA4335" Offset="0"/>
                                            <GradientStop Color="#FBBC04" Offset="0.33"/>
                                            <GradientStop Color="#34A853" Offset="0.66"/>
                                            <GradientStop Color="#4285F4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" 
                                Background="#3A3A3C" 
                                Margin="8,10"/>

                        <!-- Chrome -->
                        <Button x:Name="ChromeButton" Style="{StaticResource DockIconButtonStyle}" Click="OnChromeClick" ToolTip="Chrome">
                            <Grid Width="36" Height="36">
                                <Ellipse Width="36" Height="36" Fill="#FFFFFF"/>
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" 
                                      Fill="#4285F4" Width="28" Height="28" Stretch="Uniform"/>
                                <Ellipse x:Name="ChromeIndicator" Width="6" Height="6" Fill="#4CAF50" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Files -->
                        <Button x:Name="FilesButton" Style="{StaticResource DockIconButtonStyle}" Click="OnFilesClick" ToolTip="Files">
                            <Grid Width="36" Height="36">
                                <Rectangle Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="#5C9CE6"/>
                                <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                      Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform"/>
                                <Ellipse x:Name="FilesIndicator" Width="6" Height="6" Fill="#4CAF50" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Settings -->
                        <Button x:Name="SettingsButton" Style="{StaticResource DockIconButtonStyle}" Click="OnSettingsClick" ToolTip="Settings">
                            <Grid Width="36" Height="36">
                                <Rectangle Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="#7F7F7F"/>
                                <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z" 
                                      Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform"/>
                                <Ellipse x:Name="SettingsIndicator" Width="6" Height="6" Fill="#4CAF50" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Terminal -->
                        <Button x:Name="TerminalButton" Style="{StaticResource DockIconButtonStyle}" Click="OnTerminalClick" ToolTip="Terminal">
                            <Grid Width="36" Height="36">
                                <Rectangle Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="#000000"/>
                                <Path Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 14H4V6h8v12zm1 0l4-4-4-4v2H9v4h4v2z" 
                                      Fill="#00FF00" Width="24" Height="24" Stretch="Uniform"/>
                                <Ellipse x:Name="TerminalIndicator" Width="6" Height="6" Fill="#4CAF50" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Calculator -->
                        <Button x:Name="CalculatorButton" Style="{StaticResource DockIconButtonStyle}" Click="OnCalculatorClick" ToolTip="Calculator">
                            <Grid Width="36" Height="36">
                                <Rectangle Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="#34C759"/>
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 2h2v2h-2V5zm0 4h2v2h-2V9zm-4 0h2v2H8V9zm-2 4h2v2H6v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM6 13h2v2H6v-2zm8 4h2v2h-2v-2zm-4 0h2v2h-2v-2zm-4 0h2v2H6v-2z" 
                                      Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform"/>
                                <Ellipse x:Name="CalculatorIndicator" Width="6" Height="6" Fill="#4CAF50" Margin="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Center spacer -->
                    <Grid Grid.Column="1"/>

                    <!-- Right side - System tray -->
                    <local:SystemTray x:Name="SystemTrayControl" 
                                      Grid.Column="2"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="4,0,8,0"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
