<UserControl x:Class="ChromeOS.Controls.BatteryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Border Background="#2C2C2E" 
                CornerRadius="16" 
                Width="340" 
                Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="Battery" 
                           Foreground="#FFFFFF" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- 电量显示 -->
                <DockPanel Margin="0,0,0,16">
                    <Grid Width="60" Height="30" DockPanel.Dock="Left">
                        <Border Background="#48484A" 
                                CornerRadius="4" 
                                Width="52" 
                                Height="24"
                                HorizontalAlignment="Left"/>
                        <Border Background="#48484A" 
                                CornerRadius="1,1,2,2" 
                                Width="6" 
                                Height="12"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Right"/>
                        <Border x:Name="BatteryFill"
                                Background="#4285F4" 
                                CornerRadius="2" 
                                Width="40" 
                                Height="20"
                                Margin="2,2,0,2"
                                HorizontalAlignment="Left"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0">
                        <TextBlock x:Name="BatteryPercentText" 
                                   Text="85%" 
                                   Foreground="#FFFFFF" 
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="BatteryStatusText" 
                                   Text="Battery Charging" 
                                   Foreground="#9AA0A6" 
                                   FontSize="13"/>
                    </StackPanel>
                </DockPanel>

                <!-- 电池详情 -->
                <Border Background="#35363A" 
                        CornerRadius="12" 
                        Padding="12"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                   Text="Time remaining" 
                                   Foreground="#9AA0A6" 
                                   FontSize="13"
                                   Margin="0,0,12,8"/>
                        <TextBlock x:Name="TimeRemaining"
                                   Grid.Row="0" Grid.Column="1" 
                                   Text="Approx. 6 hours" 
                                   Foreground="#FFFFFF" 
                                   FontSize="13"
                                   Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                   Text="Power source" 
                                   Foreground="#9AA0A6" 
                                   FontSize="13"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="PowerSource"
                                   Grid.Row="1" Grid.Column="1" 
                                   Text="AC Adapter" 
                                   Foreground="#FFFFFF" 
                                   FontSize="13"/>
                    </Grid>
                </Border>

                <!-- 电池设置 -->
                <Button Click="OnOpenBatterySettings"
                        Background="Transparent"
                        Foreground="#9AA0A6"
                        Padding="8,4"
                        BorderThickness="0"
                        HorizontalAlignment="Left">
                    <Button.Content>
                        <TextBlock Text="Battery Settings" FontSize="13"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
