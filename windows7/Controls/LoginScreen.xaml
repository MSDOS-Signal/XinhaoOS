<UserControl x:Class="ChromeOS.Controls.LoginScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Background gradient (macOS + Google Hybrid style) -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="0.5"/>
                <GradientStop Color="#0F172A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative elements -->
        <Canvas>
            <Ellipse Width="400" Height="400" Fill="#4285F4" Opacity="0.1" Canvas.Left="-100" Canvas.Top="-100"/>
            <Ellipse Width="300" Height="300" Fill="#EA4335" Opacity="0.08" Canvas.Right="-50" Canvas.Bottom="-50"/>
            <Ellipse Width="200" Height="200" Fill="#FBBC05" Opacity="0.06" Canvas.Left="100" Canvas.Bottom="100"/>
            <Ellipse Width="250" Height="250" Fill="#34A853" Opacity="0.07" Canvas.Right="100" Canvas.Top="100"/>
        </Canvas>

        <!-- Center content - macOS style login panel -->
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#1E1E1E"
                CornerRadius="20"
                Padding="60,40">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- OS Name -->
                <TextBlock Text="XinhaoOS" 
                           Foreground="White" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           TextAlignment="Center"
                           Margin="0,0,0,40">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.3"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Time & Date -->
                <TextBlock x:Name="LoginTimeText" 
                           Text="12:00" 
                           Foreground="White" 
                           FontSize="64" 
                           FontWeight="Light" 
                           TextAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="LoginDateText" 
                           Text="Saturday, May 30" 
                           Foreground="#98989D" 
                           FontSize="16" 
                           FontWeight="Light" 
                           TextAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- User avatar - macOS style -->
                <Grid Margin="0,0,0,24">
                    <Ellipse Width="96" Height="96" Fill="#2C2C2E" Stroke="#48484A" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                          Fill="#0A84FF" Width="48" Height="48" Stretch="Uniform" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Username -->
                <TextBlock Text="User" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Medium"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Password input - macOS style -->
                <PasswordBox x:Name="PasswordInput" 
                             Width="280" 
                             Height="44" 
                             FontSize="16"
                             Foreground="White"
                             VerticalContentAlignment="Center"
                             KeyDown="OnPasswordKeyDown"
                             Margin="0,0,0,12">
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="#2C2C2E" 
                                    BorderBrush="#48484A"
                                    BorderThickness="1"
                                    CornerRadius="10" 
                                    Padding="16,0">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>

                <!-- Login Button - macOS style -->
                <Button x:Name="LoginButton"
                        Width="280" Height="44" 
                        Background="#0A84FF" 
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="15"
                        FontWeight="Medium"
                        Content="Log In"
                        Click="OnLoginClick"
                        Margin="0,8,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#409CFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#0077ED"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock x:Name="ErrorText" 
                           Text="" 
                           Foreground="#FF6B6B" 
                           FontSize="13" 
                           TextAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
