<UserControl x:Class="ChromeOS.Controls.NetworkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Border Background="#2C2C2E" 
                CornerRadius="16" 
                Width="360" 
                Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <!-- 标题和开关 -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="📶" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Network" 
                                   Foreground="#FFFFFF" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ToggleButton x:Name="WifiToggle" 
                                  Checked="OnWifiToggle" 
                                  Unchecked="OnWifiToggle"
                                  DockPanel.Dock="Right">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Width="48" Height="28">
                                                <Border x:Name="BackgroundBorder"
                                                        Background="#3E3E42"
                                                        CornerRadius="14"/>
                                                <Ellipse x:Name="Thumb" 
                                                         Fill="#FFFFFF" 
                                                         Width="22" 
                                                         Height="22"
                                                         Margin="3,3,0,3"
                                                         HorizontalAlignment="Left">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="BackgroundBorder" Property="Background" Value="#4285F4"/>
                                                    <Setter TargetName="Thumb" Property="Margin" Value="0,3,3,3"/>
                                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </DockPanel>

                <!-- 已连接网络 -->
                <Border x:Name="ConnectedNetwork" Background="#4285F4" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Connected" Foreground="#B3D4FC" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ConnectedNetworkName" Text="XinhaoOS-WiFi" Foreground="#FFFFFF" FontSize="15" FontWeight="Medium"/>
                        <TextBlock Text="Excellent signal" Foreground="#FFFFFF" FontSize="12" Opacity="0.8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 可用网络列表 -->
                <TextBlock Text="Other Networks" 
                           Foreground="#9AA0A6" 
                           FontSize="13"
                           Margin="0,0,0,8"/>
                <ScrollViewer x:Name="NetworkListScroll" Height="200" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NetworkList">
                        <!-- 网络列表将动态填充 -->
                    </StackPanel>
                </ScrollViewer>

                <!-- 蓝牙选项 -->
                <Border Background="#35363A" 
                        CornerRadius="12" 
                        Padding="14"
                        Margin="0,12,0,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="🔵" FontSize="20" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Bluetooth" 
                                           Foreground="#FFFFFF" 
                                           FontSize="14"/>
                                <TextBlock Text="On" 
                                           Foreground="#9AA0A6" 
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <ToggleButton x:Name="BluetoothToggle" 
                                      Checked="OnBluetoothToggle" 
                                      Unchecked="OnBluetoothToggle"
                                      DockPanel.Dock="Right"
                                      VerticalAlignment="Center">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="48" Height="28">
                                                    <Border x:Name="BackgroundBorder"
                                                            Background="#3E3E42"
                                                            CornerRadius="14"/>
                                                    <Ellipse x:Name="Thumb" 
                                                             Fill="#FFFFFF" 
                                                             Width="22" 
                                                             Height="22"
                                                             Margin="3,3,0,3"
                                                             HorizontalAlignment="Left">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="2" Opacity="0.3"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="BackgroundBorder" Property="Background" Value="#4285F4"/>
                                                        <Setter TargetName="Thumb" Property="Margin" Value="0,3,3,3"/>
                                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </DockPanel>
                </Border>

                <!-- 网络设置按钮 -->
                <Button Click="OnOpenNetworkSettings"
                        Background="Transparent"
                        Foreground="#9AA0A6"
                        Padding="8,4"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                    <Button.Content>
                        <TextBlock Text="Network Settings" FontSize="13"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
