<UserControl x:Class="ChromeOS.Controls.ShutdownScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0D0D0F">
        <Grid.Resources>
            <RadialGradientBrush x:Key="ShutdownGradient" Center="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#1E1E20" Offset="0"/>
                <GradientStop Color="#0D0D0F" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Resources>

        <Grid Background="{StaticResource ShutdownGradient}">
            <Canvas>
                <Ellipse Width="700" Height="700" Fill="#5B5BE4" Opacity="0.06" Canvas.Left="-200" Canvas.Top="-100">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="Orb1Scale" ScaleX="1" ScaleY="1" CenterX="350" CenterY="350"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="500" Height="500" Fill="#8B5CF6" Opacity="0.05" Canvas.Right="-150" Canvas.Bottom="-120">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="Orb2Scale" ScaleX="1" ScaleY="1" CenterX="250" CenterY="250"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                <Grid Width="120" Height="120" Margin="0,0,0,30">
                    <Ellipse Width="120" Height="120" Fill="#5B5BE4" Opacity="0.15">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" CenterX="60" CenterY="60"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="90" Height="90" Stroke="#5B5BE4" StrokeThickness="2" Opacity="0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="OuterRotate" Angle="0" CenterX="45" CenterY="45"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="70" Height="70" Stroke="#8B5CF6" StrokeThickness="1.5" Opacity="0.6">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="InnerRotate" Angle="0" CenterX="35" CenterY="35"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="24" Height="24" Fill="#8B5CF6" Opacity="0.8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <TextBlock Text="正在关机..." 
                           Foreground="#FFFFFF" 
                           FontSize="16" 
                           FontWeight="Medium"
                           TextAlignment="Center"/>
                <TextBlock Text="感谢您的使用！" 
                           Foreground="#6B6B70" 
                           FontSize="14" 
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,100">
                <ProgressBar x:Name="ShutdownProgress"
                             Width="220" 
                             Height="4" 
                             Background="#2E2E32"
                             Foreground="#5B5BE4"
                             BorderThickness="0"
                             IsIndeterminate="True"
                             Margin="0,0,0,16"/>
                <TextBlock Text="请稍候..." 
                           Foreground="#6B6B70" 
                           FontSize="12" 
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>