<UserControl x:Class="ChromeOS.Controls.VolumePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Border Background="#2C2C2E" 
                CornerRadius="16" 
                Width="340" 
                Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="Sound" 
                           Foreground="#FFFFFF" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- 音量控制 -->
                <DockPanel Margin="0,0,0,16">
                    <TextBlock x:Name="VolumeIcon" 
                               Text="🔊" 
                               FontSize="24" 
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Slider x:Name="VolumeSlider"
                            DockPanel.Dock="Left"
                            Minimum="0" 
                            Maximum="100" 
                            Value="70"
                            ValueChanged="OnVolumeChanged"
                            Width="230"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="VolumePercent" 
                               Text="70%" 
                               Foreground="#9AA0A6" 
                               FontSize="13" 
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 输出设备 -->
                <Border Background="#35363A" 
                        CornerRadius="12" 
                        Padding="12"
                        Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Text="🔊" 
                                   FontSize="20" 
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Speakers" 
                                       Foreground="#FFFFFF" 
                                       FontSize="14"/>
                            <TextBlock Text="Realtek Audio" 
                                       Foreground="#9AA0A6" 
                                       FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 输入设备 -->
                <Border Background="#35363A" 
                        CornerRadius="12" 
                        Padding="12"
                        Margin="0,0,0,16">
                    <DockPanel>
                        <TextBlock Text="🎤" 
                                   FontSize="20" 
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Microphone" 
                                       Foreground="#FFFFFF" 
                                       FontSize="14"/>
                            <TextBlock Text="Realtek Audio" 
                                       Foreground="#9AA0A6" 
                                       FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 声音设置按钮 -->
                <Button Click="OnOpenSoundSettings"
                        Background="Transparent"
                        Foreground="#9AA0A6"
                        Padding="8,4"
                        BorderThickness="0"
                        HorizontalAlignment="Left">
                    <Button.Content>
                        <TextBlock Text="Sound Settings" FontSize="13"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
