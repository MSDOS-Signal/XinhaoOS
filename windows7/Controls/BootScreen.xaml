<UserControl x:Class="ChromeOS.Controls.BootScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="0.5"/>
                <GradientStop Color="#0F172A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <!-- Decorative circles - Google theme colors -->
        <Canvas>
            <Ellipse Width="400" Height="400" Fill="#4285F4" Opacity="0.08" Canvas.Left="-100" Canvas.Top="-100"/>
            <Ellipse Width="350" Height="350" Fill="#EA4335" Opacity="0.06" Canvas.Right="-80" Canvas.Top="-50"/>
            <Ellipse Width="300" Height="300" Fill="#FBBC05" Opacity="0.05" Canvas.Left="100" Canvas.Bottom="-80"/>
            <Ellipse Width="250" Height="250" Fill="#34A853" Opacity="0.07" Canvas.Right="50" Canvas.Bottom="-30"/>
        </Canvas>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Logo Image -->
            <Image x:Name="LogoImage" 
                   Width="200" 
                   Height="200" 
                   Stretch="Uniform"
                   Margin="0,0,0,20"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
                <Image.Effect>
                    <DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Image.Effect>
            </Image>
            
            <!-- XinhaoOS Logo Text -->
            <TextBlock Text="XinhaoOS" 
                       Foreground="White" 
                       FontSize="48" 
                       FontWeight="Bold" 
                       TextAlignment="Center"
                       Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                </TextBlock.Effect>
            </TextBlock>
            
            <!-- Loading animation -->
            <ProgressBar x:Name="LoadingBar" 
                         Width="280" 
                         Height="6" 
                         Minimum="0" 
                         Maximum="100" 
                         Foreground="#0A84FF" 
                         Background="#2C2C2E"
                         BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>
