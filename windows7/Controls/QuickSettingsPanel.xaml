<UserControl x:Class="ChromeOS.Controls.QuickSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource ChromeOSShelf}" 
            BorderBrush="#5F6368" 
            BorderThickness="1"
            CornerRadius="12"
            Width="360">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="16">
            <!-- WiFi -->
            <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="📶" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="WifiText" Text="WiFi" Foreground="#E8EAED" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel x:Name="WifiDetails">
                        <TextBlock Text="Connected: ChromeOS-WiFi" Foreground="#81C995" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="Signal: Excellent | Speed: 100 Mbps" Foreground="#9AA0A6" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bluetooth -->
            <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔵" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BtText" Text="Bluetooth" Foreground="#E8EAED" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel x:Name="BtDetails">
                        <TextBlock Text="On" Foreground="#8AB4F8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quick Toggles -->
            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="WifiToggleBtn" Style="{StaticResource ChromeOSButton}" Width="100" Height="60" Margin="0,0,8,8" Click="OnWifiToggleClick" Background="#8AB4F8">
                    <StackPanel>
                        <TextBlock Text="📶" FontSize="20"/>
                        <TextBlock Text="WiFi" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtToggleBtn" Style="{StaticResource ChromeOSButton}" Width="100" Height="60" Margin="0,0,8,8" Click="OnBtToggleClick" Background="#8AB4F8">
                    <StackPanel>
                        <TextBlock Text="🔵" FontSize="20"/>
                        <TextBlock Text="Bluetooth" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Width="100" Height="60" Margin="0,0,8,8" Background="#35363A" Click="OnAirplaneModeClick">
                    <StackPanel>
                        <TextBlock Text="✈️" FontSize="20"/>
                        <TextBlock Text="Airplane" Foreground="#9AA0A6" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Width="100" Height="60" Margin="0,0,8,8" Background="#35363A" Click="OnDoNotDisturbClick">
                    <StackPanel>
                        <TextBlock Text="🔕" FontSize="20"/>
                        <TextBlock Text="DND" Foreground="#9AA0A6" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Width="100" Height="60" Margin="0,0,8,8" Background="#35363A" Click="OnNightLightClick">
                    <StackPanel>
                        <TextBlock Text="🌙" FontSize="20"/>
                        <TextBlock Text="Night Light" Foreground="#9AA0A6" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Width="100" Height="60" Margin="0,0,8,8" Background="#35363A" Click="OnLocationClick">
                    <StackPanel>
                        <TextBlock Text="📍" FontSize="20"/>
                        <TextBlock Text="Location" Foreground="#9AA0A6" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Brightness -->
            <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="☀️" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Brightness" Foreground="#E8EAED" FontSize="13"/>
                    </StackPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="80" 
                            Background="#5F6368" Foreground="#8AB4F8"
                            ValueChanged="OnBrightnessChanged"/>
                </StackPanel>
            </Border>

            <!-- Volume -->
            <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Volume" Foreground="#E8EAED" FontSize="13"/>
                    </StackPanel>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="70" 
                            Background="#5F6368" Foreground="#81C995"
                            ValueChanged="OnVolumeChanged"/>
                </StackPanel>
            </Border>

            <!-- Battery -->
        <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,12">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔋" FontSize="18" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="BatteryText" Text="Battery - 85%" Foreground="#E8EAED" FontSize="13"/>
                        <TextBlock Text="Approx. 6 hours remaining" Foreground="#9AA0A6" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

            <!-- Power options -->
            <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,12">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔌" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Power" Foreground="#E8EAED" FontSize="13"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource ChromeOSButton}" Width="80" Height="70" Margin="0,0,8,0" Background="#3C3D40" Click="OnLockScreenClick">
                            <StackPanel>
                                <TextBlock Text="🔒" FontSize="22"/>
                                <TextBlock Text="Lock" Foreground="#E8EAED" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Width="80" Height="70" Margin="0,0,8,0" Background="#3C3D40" Click="OnLogOutClick">
                            <StackPanel>
                                <TextBlock Text="🚪" FontSize="22"/>
                                <TextBlock Text="Log Out" Foreground="#E8EAED" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Width="80" Height="70" Margin="0,0,8,0" Background="#3C3D40" Click="OnSleepClick">
                            <StackPanel>
                                <TextBlock Text="😴" FontSize="22"/>
                                <TextBlock Text="Sleep" Foreground="#E8EAED" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Width="80" Height="70" Margin="0,0,0,0" Background="#FF6B6B" Click="OnPowerOffClick">
                            <StackPanel>
                                <TextBlock Text="🔴" FontSize="22"/>
                                <TextBlock Text="Power Off" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Settings button -->
            <Button Style="{StaticResource ChromeOSButton}" Height="36" Click="OnSettingsClick" Background="#3C3D40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="See all settings" Foreground="#E8EAED" FontSize="13"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
