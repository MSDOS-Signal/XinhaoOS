<UserControl x:Class="ChromeOS.Controls.LauncherControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Visibility="Collapsed">
    <Grid>
        <!-- Background dimmer -->
        <Rectangle Fill="#80000000" MouseDown="OnBackgroundClick"/>

        <!-- Launcher panel -->
        <Border VerticalAlignment="Bottom" 
                HorizontalAlignment="Center"
                Background="{StaticResource ChromeOSLauncherBackground}"
                CornerRadius="24,24,0,0"
                Width="680"
                MaxHeight="600"
                Margin="0,0,0,60"
                Padding="20">
            <StackPanel>
                <!-- Search bar -->
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource ChromeOSTextBox}"
                         Text="Search apps, files..."
                         Foreground="{StaticResource ChromeOSTextSecondary}"
                         Margin="0,10,0,20"
                         GotFocus="OnSearchGotFocus"
                         LostFocus="OnSearchLostFocus"
                         TextChanged="OnSearchTextChanged"/>

                <!-- App grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <WrapPanel x:Name="AppGrid"
                               HorizontalAlignment="Center"
                               ItemWidth="90"
                               ItemHeight="110">
                        <!-- Chrome Browser -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Chrome" Click="OnChromeClick">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" 
                                  Fill="#4285F4" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Files -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Files" Click="OnFilesClick">
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" 
                                  Fill="#5F6368" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Settings -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Settings" Click="OnSettingsClick">
                            <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z" 
                                  Fill="#9AA0A6" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Terminal -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Terminal" Click="OnTerminalClick">
                            <Path Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 14H4V6h8v12zm1 0l4-4-4-4v2H9v4h4v2z" 
                                  Fill="#8AB4F8" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Text Editor -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Text Editor" Click="OnTextEditorClick">
                            <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 15h8v2H8v-2zm0-4h8v2H8v-2z" 
                                  Fill="#E8EAED" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Calculator -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Calculator" Click="OnCalculatorClick">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 2h2v2h-2V5zm0 4h2v2h-2V9zm-4 0h2v2H8V9zm-2 4h2v2H6v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM6 13h2v2H6v-2zm8 4h2v2h-2v-2zm-4 0h2v2h-2v-2zm-4 0h2v2H6v-2z" 
                                  Fill="#81C995" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Camera -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Camera" Click="OnCameraClick">
                            <Path Data="M20 4h-3.17L15 2H9L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-8 13c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.65 0-3 1.35-3 3s1.35 3 3 3 3-1.35 3-3-1.35-3-3-3z" 
                                  Fill="#FDD663" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Photos -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Photos" Click="OnPhotosClick">
                            <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" 
                                  Fill="#F28B82" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Play Store -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Play Store" Click="OnPlayStoreClick">
                            <Path Data="M19.5 12.57l-7.5 7.5-7.5-7.5L12 5.07l7.5 7.5zM12 3l-9 9 9 9 9-9-9-9z" 
                                  Fill="#AECBFA" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Downloads -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Downloads" Click="OnDownloadsClick">
                            <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" 
                                  Fill="#8AB4F8" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Gmail -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Gmail" Click="OnGmailClick">
                            <Path Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" 
                                  Fill="#EA4335" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- YouTube -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="YouTube" Click="OnYouTubeClick">
                            <Path Data="M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z" 
                                  Fill="#FF0000" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Maps -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Maps" Click="OnMapsClick">
                            <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z" 
                                  Fill="#34A853" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Drive -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Drive" Click="OnDriveClick">
                            <Path Data="M7.71 3.5H1.15L4.43 9.2H10.99L7.71 3.5zM4.61 9.5H1.33L3.13 12.63H6.41L4.61 9.5zM12.29 3.5L9.01 9.2H15.57L12.29 3.5zM16.87 9.2L13.59 3.5L10.31 9.2H16.87zM13.29 12.33H9.01L12.29 18.03H16.57L13.29 12.33zM7.89 12.33H4.61L7.89 18.03H11.17L7.89 12.33z" 
                                  Fill="#4285F4" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Clock -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Clock" Click="OnClockClick">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" 
                                  Fill="#5F6368" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Calendar -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Calendar" Click="OnCalendarClick">
                            <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z" 
                                  Fill="#4285F4" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Weather -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Weather" Click="OnWeatherClick">
                            <Path Data="M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.79 1.42-1.41zM4 10.5H1v2h3v-2zm9-9.95h-2V3.5h2V.55zm7.45 3.91l-1.41-1.41-1.79 1.79 1.41 1.41 1.79-1.79zm-3.21 13.7l1.79 1.8 1.41-1.41-1.8-1.79-1.4 1.4zM20 10.5v2h3v-2h-3zm-8-5c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm-1 16.95h2V19.5h-2v2.95zm-7.45-3.91l1.41 1.41 1.79-1.8-1.41-1.41-1.79 1.8z" 
                                  Fill="#FDD663" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- News -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="News" Click="OnNewsClick">
                            <Path Data="M22 3l-1.67 1.67L18.67 3 17 4.67 15.33 3l-1.66 1.67L12 3l-1.67 1.67L8.67 3 7 4.67 5.33 3 3.67 4.67 2 3v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V3zM11 19H4v-6h7v6zm9 0h-7v-2h7v2zm0-4h-7v-2h7v2zm0-4H4V8h16v3z" 
                                  Fill="#8AB4F8" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Music -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Music" Click="OnMusicClick">
                            <Path Data="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z" 
                                  Fill="#81C995" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>

                        <!-- Contacts -->
                        <Button Style="{StaticResource LauncherAppIcon}" 
                                Tag="Contacts" Click="OnContactsClick">
                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                  Fill="#AECBFA" Width="32" Height="32" Stretch="Uniform"/>
                        </Button>
                    </WrapPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
