<UserControl x:Class="ChromeOS.Controls.NotificationCenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource ChromeOSShelf}" 
            BorderBrush="#5F6368" 
            BorderThickness="1"
            CornerRadius="12"
            Width="380"
            MaxHeight="600">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="#35363A" Padding="16,12" CornerRadius="12,12,0,0">
                <Grid>
                    <TextBlock Text="Notifications" Foreground="#E8EAED" FontSize="16" FontWeight="Medium"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource ChromeOSButton}" Padding="8,4" Click="OnClearAllClick">
                        <TextBlock Text="Clear all" Foreground="#8AB4F8" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Notification List -->
            <ScrollViewer x:Name="NotificationScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="NotificationList">
                    <!-- Sample notifications -->
                    <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="System" Foreground="#8AB4F8" FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="Welcome to ChromeOS! Your system is up to date." Foreground="#E8EAED" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="2 min ago" Foreground="#9AA0A6" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="WiFi" Foreground="#81C995" FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="Connected to ChromeOS-WiFi" Foreground="#E8EAED" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="5 min ago" Foreground="#9AA0A6" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Updates" Foreground="#FDD663" FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="ChromeOS update available: Version 122.0.6261.51" Foreground="#E8EAED" FontSize="13" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Button Style="{StaticResource ChromeOSButton}" Padding="8,4" Margin="0,0,8,0" Click="OnUpdateClick">
                                    <TextBlock Text="Update" Foreground="#8AB4F8" FontSize="11"/>
                                </Button>
                                <TextBlock Text="1 hour ago" Foreground="#9AA0A6" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#35363A" CornerRadius="8" Margin="0,0,0,8" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Battery" Foreground="#F28B82" FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="Battery saver mode enabled (85% remaining)" Foreground="#E8EAED" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock DockPanel.Dock="Bottom" Text="2 hours ago" Foreground="#9AA0A6" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="#35363A" Padding="16,8" CornerRadius="0,0,12,12">
                <Button Style="{StaticResource ChromeOSButton}" Height="36" Click="OnSettingsClick">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Notification settings" Foreground="#E8EAED" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
