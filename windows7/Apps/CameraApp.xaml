<UserControl x:Class="ChromeOS.Apps.CameraApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#1E1E1E">
        <!-- Camera toolbar -->
        <Border DockPanel.Dock="Top" Background="#35363A" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Camera" Foreground="#E8EAED" FontSize="16" Margin="12,0"/>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="8,0" FontSize="12" Click="OnSwitchCamera">
                    <TextBlock Text="Switch" Foreground="#E8EAED"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="4,0" FontSize="12" Click="OnTimerClick">
                    <TextBlock Text="Timer" Foreground="#E8EAED"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="4,0" FontSize="12" Click="OnSettingsClick">
                    <TextBlock Text="Settings" Foreground="#E8EAED"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Camera view -->
        <Grid>
            <!-- Placeholder for camera view -->
            <Rectangle Fill="#000000"/>
            <TextBlock Text="Camera is not available in this environment" 
                       Foreground="#9AA0A6" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <!-- Camera controls -->
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,30">
                <!-- Gallery preview -->
                <Border Width="50" Height="50" CornerRadius="8" Background="#35363A" 
                        HorizontalAlignment="Right" Margin="0,0,20,10" 
                        MouseLeftButtonDown="OnGalleryClick">
                    <Image Source="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=photo%20icon%20simple%20flat%20design&amp;image_size=square"/>
                </Border>

                <!-- Shutter button -->
                <Ellipse Width="70" Height="70" Fill="White" Stroke="#E8EAED" StrokeThickness="4" 
                         HorizontalAlignment="Center" MouseLeftButtonDown="OnShutterClick"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
