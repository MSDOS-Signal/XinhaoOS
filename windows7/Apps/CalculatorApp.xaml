<UserControl x:Class="ChromeOS.Apps.CalculatorApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#292A2D" Padding="16">
        <StackPanel>
            <!-- Display -->
            <Border Background="#35363A" CornerRadius="8" Padding="16,20" Margin="0,0,0,12">
                <TextBlock x:Name="Display" 
                           Text="0" 
                           Foreground="#E8EAED" 
                           FontSize="36" 
                           TextAlignment="Right"
                           HorizontalAlignment="Stretch"/>
            </Border>

            <!-- Buttons -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 1 -->
                <Button Content="C" Grid.Row="0" Grid.Column="0" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnClearClick"/>
                <Button Content="+/-" Grid.Row="0" Grid.Column="1" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNegateClick"/>
                <Button Content="%" Grid.Row="0" Grid.Column="2" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnPercentClick"/>
                <Button Content="÷" Grid.Row="0" Grid.Column="3" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnDivideClick"/>

                <!-- Row 2 -->
                <Button Content="7" Grid.Row="1" Grid.Column="0" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="8" Grid.Row="1" Grid.Column="1" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="9" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="×" Grid.Row="1" Grid.Column="3" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnMultiplyClick"/>

                <!-- Row 3 -->
                <Button Content="4" Grid.Row="2" Grid.Column="0" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="5" Grid.Row="2" Grid.Column="1" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="6" Grid.Row="2" Grid.Column="2" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="-" Grid.Row="2" Grid.Column="3" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnSubtractClick"/>

                <!-- Row 4 -->
                <Button Content="1" Grid.Row="3" Grid.Column="0" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="2" Grid.Row="3" Grid.Column="1" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="3" Grid.Row="3" Grid.Column="2" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="+" Grid.Row="3" Grid.Column="3" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnAddClick"/>

                <!-- Row 5 -->
                <Button Content="0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnNumberClick"/>
                <Button Content="." Grid.Row="4" Grid.Column="2" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnDecimalClick"/>
                <Button Content="=" Grid.Row="4" Grid.Column="3" Style="{StaticResource ChromeOSButton}" Margin="3" FontSize="18" Click="OnEqualsClick"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
