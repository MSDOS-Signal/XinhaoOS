<UserControl x:Class="ChromeOS.Apps.FilesApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#292A2D">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#35363A" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackBtn" Style="{StaticResource ChromeOSButton}" Padding="8,5" Margin="8,0" FontSize="12" Click="OnBackClick" ToolTip="Back">
                    <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Fill="#E8EAED" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button x:Name="UpBtn" Style="{StaticResource ChromeOSButton}" Padding="8,5" Margin="4,0" FontSize="12" Click="OnUpClick" ToolTip="Up">
                    <Path Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.59 5.58L20 12l-8-8-8 8z" Fill="#E8EAED" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button x:Name="RefreshBtn" Style="{StaticResource ChromeOSButton}" Padding="8,5" Margin="4,0" FontSize="12" Click="OnRefreshClick" ToolTip="Refresh">
                    <Path Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="#E8EAED" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,5" Margin="12,0,4,0" FontSize="12" Click="OnNewFolderClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#E8EAED" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"/>
                        <TextBlock Text="New Folder" Foreground="#E8EAED"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,5" Margin="4,0" FontSize="12" Click="OnNewFileClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z" Fill="#E8EAED" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0"/>
                        <TextBlock Text="New File" Foreground="#E8EAED"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="SearchBox" Width="200" Margin="16,0" Padding="8,4" Background="#292A2D" Foreground="#E8EAED" BorderBrush="#5F6368" BorderThickness="1" FontSize="12" VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Search files..." Foreground="#9AA0A6" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button x:Name="PathText" Style="{StaticResource ChromeOSButton}" Padding="10,5" Margin="0,0,4,0" FontSize="12" Click="OnPathTextClick">
                    <TextBlock Text="My files" Foreground="#E8EAED"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,5" Margin="4,0" FontSize="12" Click="OnViewToggleClick" ToolTip="Toggle view">
                    <TextBlock x:Name="ViewIcon" Text="▦" Foreground="#E8EAED" FontSize="14"/>
                </Button>
            </StackPanel>
        </Border>

        <DockPanel>
            <!-- Sidebar -->
            <Border DockPanel.Dock="Left" Background="#35363A" Width="200">
                <StackPanel Margin="8">
                    <Button x:Name="NavMyFiles" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnNavMyFilesClick" Background="#3C3D40">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#8AB4F8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="My files" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavDownloads" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnNavDownloadsClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Fill="#8AB4F8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Downloads" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPlayFiles" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnNavPlayFilesClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zM6 20V4h7l5 5v11H6z" Fill="#81C995" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Play Files" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavImages" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnNavImagesClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M21 3H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14z" Fill="#FDD663" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Images" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,8" Background="#5F6368"/>
                    <Button x:Name="NavDocuments" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnNavDocumentsClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#F28B82" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Documents" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavMusic" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnNavMusicClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z" Fill="#FDD663" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Music" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- File list -->
            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="FileList" Margin="16"/>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
