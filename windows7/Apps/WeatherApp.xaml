<UserControl x:Class="ChromeOS.Apps.WeatherApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#292A2D">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <!-- Current Weather -->
                <Border Background="#35363A" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="☀️" FontSize="80"/>
                            <TextBlock Text="晴天" FontSize="18" Foreground="#9AA0A6" Margin="0,4,0,0"/>
                            <TextBlock Text="北京" FontSize="14" Foreground="#9AA0A6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock x:Name="CurrentTemp" Text="28°" FontSize="72" FontWeight="Light"
                                       Foreground="#E8EAED" HorizontalAlignment="Left"/>
                            <TextBlock Text="体感温度 30° · 最高32° 最低22°" FontSize="14"
                                       Foreground="#9AA0A6" Margin="0,4,0,0"/>
                            <TextBlock x:Name="CurrentDate" Text="" FontSize="12"
                                       Foreground="#9AA0A6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Weather Details -->
                <Border Background="#35363A" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="天气详情" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="💧" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="湿度" FontSize="12" Foreground="#9AA0A6" Margin="0,4,0,0"/>
                                <TextBlock Text="65%" FontSize="18" Foreground="#E8EAED"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="🌬" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="风速" FontSize="12" Foreground="#9AA0A6" Margin="0,4,0,0"/>
                                <TextBlock Text="12km/h" FontSize="18" Foreground="#E8EAED"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="👁" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="能见度" FontSize="12" Foreground="#9AA0A6" Margin="0,4,0,0"/>
                                <TextBlock Text="10km" FontSize="18" Foreground="#E8EAED"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="☂" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="降水" FontSize="12" Foreground="#9AA0A6" Margin="0,4,0,0"/>
                                <TextBlock Text="10%" FontSize="18" Foreground="#E8EAED"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hourly Forecast -->
                <Border Background="#35363A" CornerRadius="16" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="每小时预报" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="HourlyForecast" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 7-Day Forecast -->
                <Border Background="#35363A" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="7日预报" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,12"/>
                        <StackPanel x:Name="DailyForecast"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
