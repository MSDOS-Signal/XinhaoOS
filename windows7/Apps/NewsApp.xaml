<UserControl x:Class="ChromeOS.Apps.NewsApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#292A2D">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#35363A" BorderBrush="#5F6368" BorderThickness="0,0,0,1" Margin="0,0,0,42" Grid.RowSpan="2">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="📰" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="新闻" FontSize="20" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1" Width="300" HorizontalAlignment="Center"
                         Style="{StaticResource ChromeOSTextBox}"
                         Text="搜索新闻" Foreground="#9AA0A6" FontSize="14"
                         GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus" Margin="0,3,0,3" TextChanged="TextBox_TextChanged"/>
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Content="推荐" Style="{StaticResource ChromeOSButton}"
                            Padding="16,8" Margin="0,0,4,0" Click="OnCategoryClick" Tag="recommend"/>
                    <Button Content="科技" Style="{StaticResource ChromeOSButton}"
                            Padding="16,8" Margin="0,0,4,0" Click="OnCategoryClick" Tag="tech"/>
                    <Button Content="体育" Style="{StaticResource ChromeOSButton}"
                            Padding="16,8" Margin="0,0,4,0" Click="OnCategoryClick" Tag="sports"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- News List -->
        <Border Grid.Row="1" Background="#292A2D">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel x:Name="NewsList" Margin="16"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
