<UserControl x:Class="ChromeOS.Apps.PhotosApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#292A2D">
        <Border DockPanel.Dock="Top" Background="#35363A" Height="50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Photos" Foreground="#E8EAED" FontSize="18" Margin="16,0"/>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="8,0" FontSize="12">
                    <TextBlock Text="Library" Foreground="#8AB4F8"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="4,0" FontSize="12">
                    <TextBlock Text="Collections" Foreground="#E8EAED"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="4,0" FontSize="12">
                    <TextBlock Text="Favorites" Foreground="#E8EAED"/>
                </Button>
                <Button Style="{StaticResource ChromeOSButton}" Padding="10,4" Margin="4,0" FontSize="12" Click="OnImportClick">
                    <TextBlock Text="Import" Foreground="#E8EAED"/>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="16">
                <Border Width="150" Height="150" Background="#35363A" CornerRadius="8" Margin="6" MouseLeftButtonDown="OnPhotoClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🏔️" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Landscape" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Width="150" Height="150" Background="#35363A" CornerRadius="8" Margin="6" MouseLeftButtonDown="OnPhotoClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌅" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sunset" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Width="150" Height="150" Background="#35363A" CornerRadius="8" Margin="6" MouseLeftButtonDown="OnPhotoClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌃" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="City" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Width="150" Height="150" Background="#35363A" CornerRadius="8" Margin="6" MouseLeftButtonDown="OnPhotoClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🌸" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Flowers" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Width="150" Height="150" Background="#35363A" CornerRadius="8" Margin="6" MouseLeftButtonDown="OnPhotoClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🐱" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pet" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Width="150" Height="150" Background="#35363A" CornerRadius="8" Margin="6" MouseLeftButtonDown="OnPhotoClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🍕" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Food" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>