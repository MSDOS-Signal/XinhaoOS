<UserControl x:Class="ChromeOS.Apps.ClockApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#292A2D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Header -->
        <Border Grid.Row="0" Background="#35363A" BorderBrush="#5F6368" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                <Button Content="时钟" x:Name="TabClock" Style="{StaticResource ChromeOSButton}"
                        Padding="20,10" Margin="4,0" Click="OnTabClick" Tag="clock"/>
                <Button Content="秒表" x:Name="TabStopwatch" Style="{StaticResource ChromeOSButton}"
                        Padding="20,10" Margin="4,0" Click="OnTabClick" Tag="stopwatch"/>
                <Button Content="计时器" x:Name="TabTimer" Style="{StaticResource ChromeOSButton}"
                        Padding="20,10" Margin="4,0" Click="OnTabClick" Tag="timer"/>
                <Button Content="闹钟" x:Name="TabAlarm" Style="{StaticResource ChromeOSButton}"
                        Padding="20,10" Margin="4,0" Click="OnTabClick" Tag="alarm"/>
            </StackPanel>
        </Border>

        <!-- Tab Content -->
        <Grid Grid.Row="1" x:Name="TabContent">
            <!-- Clock Tab -->
            <StackPanel x:Name="ClockPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                <Canvas x:Name="ClockCanvas" Width="250" Height="250" Margin="0,0,0,20"/>
                <TextBlock x:Name="DigitalTime" FontSize="48" FontWeight="Light" Foreground="#E8EAED"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="DigitalDate" FontSize="16" Foreground="#9AA0A6" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Stopwatch Tab -->
            <StackPanel x:Name="StopwatchPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="StopwatchDisplay" FontSize="64" FontWeight="Light" Foreground="#E8EAED"
                           HorizontalAlignment="Center" Margin="0,0,0,12" Text="00:00.00"/>
                <TextBlock x:Name="StopwatchMs" FontSize="24" Foreground="#9AA0A6" HorizontalAlignment="Center" Margin="0,0,0,30" Text=".00"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="StopwatchStartBtn" Content="开始" Style="{StaticResource ChromeOSButton}"
                            Background="#8AB4F8" Foreground="#202124" FontWeight="SemiBold"
                            Padding="30,12" Margin="8,0" Click="OnStopwatchStartClick"/>
                    <Button Content="计次" Style="{StaticResource ChromeOSButton}"
                            Padding="30,12" Margin="8,0" Click="OnStopwatchLapClick"/>
                    <Button Content="重置" Style="{StaticResource ChromeOSButton}"
                            Padding="30,12" Margin="8,0" Click="OnStopwatchResetClick"/>
                </StackPanel>
                <ListBox x:Name="LapList" Width="300" MaxHeight="200" Margin="0,30,0,0"
                         Background="Transparent" BorderBrush="#5F6368" BorderThickness="1"
                         Foreground="#E8EAED" FontSize="14"/>
            </StackPanel>

            <!-- Timer Tab -->
            <StackPanel x:Name="TimerPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="小时" Foreground="#9AA0A6" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBox x:Name="TimerHours" Text="0" Width="60" FontSize="32" FontWeight="Light"
                                 Foreground="#E8EAED" Background="#35363A" BorderBrush="#5F6368"
                                 BorderThickness="1" TextAlignment="Center" Padding="8"/>
                    </StackPanel>
                    <TextBlock Text=":" FontSize="32" Foreground="#E8EAED" Margin="5,0,5,30"/>
                    <StackPanel Margin="10,0">
                        <TextBlock Text="分钟" Foreground="#9AA0A6" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBox x:Name="TimerMinutes" Text="5" Width="60" FontSize="32" FontWeight="Light"
                                 Foreground="#E8EAED" Background="#35363A" BorderBrush="#5F6368"
                                 BorderThickness="1" TextAlignment="Center" Padding="8"/>
                    </StackPanel>
                    <TextBlock Text=":" FontSize="32" Foreground="#E8EAED" Margin="5,0,5,30"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="秒" Foreground="#9AA0A6" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBox x:Name="TimerSeconds" Text="0" Width="60" FontSize="32" FontWeight="Light"
                                 Foreground="#E8EAED" Background="#35363A" BorderBrush="#5F6368"
                                 BorderThickness="1" TextAlignment="Center" Padding="8"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TimerDisplay" FontSize="64" FontWeight="Light" Foreground="#E8EAED"
                           HorizontalAlignment="Center" Margin="0,0,0,30" Text="00:05:00"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="TimerStartBtn" Content="开始" Style="{StaticResource ChromeOSButton}"
                            Background="#8AB4F8" Foreground="#202124" FontWeight="SemiBold"
                            Padding="30,12" Margin="8,0" Click="OnTimerStartClick"/>
                    <Button Content="重置" Style="{StaticResource ChromeOSButton}"
                            Padding="30,12" Margin="8,0" Click="OnTimerResetClick"/>
                </StackPanel>
            </StackPanel>

            <!-- Alarm Tab -->
            <StackPanel x:Name="AlarmPanel" Margin="40,30" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="时" Foreground="#9AA0A6" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBox x:Name="AlarmHour" Text="07" Width="60" FontSize="24" FontWeight="Light"
                                 Foreground="#E8EAED" Background="#35363A" BorderBrush="#5F6368"
                                 BorderThickness="1" TextAlignment="Center" Padding="8"/>
                    </StackPanel>
                    <TextBlock Text=":" FontSize="24" Foreground="#E8EAED" Margin="5,0,5,30"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="分" Foreground="#9AA0A6" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBox x:Name="AlarmMinute" Text="00" Width="60" FontSize="24" FontWeight="Light"
                                 Foreground="#E8EAED" Background="#35363A" BorderBrush="#5F6368"
                                 BorderThickness="1" TextAlignment="Center" Padding="8"/>
                    </StackPanel>
                    <Button Content="添加闹钟" Style="{StaticResource ChromeOSButton}"
                            Background="#8AB4F8" Foreground="#202124" FontWeight="SemiBold"
                            Padding="20,10" Margin="20,0,0,0" VerticalAlignment="Bottom"
                            Click="OnAddAlarmClick"/>
                </StackPanel>
                <ListBox x:Name="AlarmList" Background="Transparent" BorderBrush="#5F6368" BorderThickness="1"
                         Foreground="#E8EAED" FontSize="14" MaxHeight="300"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
