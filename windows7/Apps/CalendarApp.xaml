<UserControl x:Class="ChromeOS.Apps.CalendarApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#292A2D">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#35363A" BorderBrush="#5F6368" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📅" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="◀" Style="{StaticResource ChromeOSButton}" Padding="12,8" Click="OnPrevMonthClick"/>
                <Button Grid.Column="2" Content="▶" Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="4,0" Click="OnNextMonthClick"/>
                <TextBlock x:Name="MonthTitle" Grid.Column="3" FontSize="20" FontWeight="SemiBold" Foreground="#E8EAED"
                           VerticalAlignment="Center" Margin="16,0"/>
                <Button Grid.Column="4" Content="今天" Style="{StaticResource ChromeOSButton}"
                        Background="#3C4043" Padding="16,8" Margin="0,0,8,0" Click="OnTodayClick"/>
                <Button Grid.Column="5" Content="+ 新建事件" Style="{StaticResource ChromeOSButton}"
                        Background="#8AB4F8" Foreground="#202124" FontWeight="SemiBold"
                        Padding="16,10" Click="OnNewEventClick"/>
            </Grid>
        </Border>

        <!-- Weekday Headers -->
        <Border Grid.Row="1" Background="#292A2D" BorderBrush="#5F6368" BorderThickness="0,0,0,1">
            <Grid Margin="8,8,8,4" x:Name="WeekdayGrid"/>
        </Border>

        <!-- Calendar Grid -->
        <Border Grid.Row="2" Background="#292A2D">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="CalendarGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
