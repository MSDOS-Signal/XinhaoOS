<UserControl x:Class="ChromeOS.Apps.BrowserApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel Background="#292A2D">
        <!-- Browser toolbar -->
        <Border DockPanel.Dock="Top" Background="#35363A" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Height="74">
                    <!-- Back button -->
                    <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Click="OnBackClick">
                        <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" 
                              Fill="#9AA0A6" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <!-- Forward button -->
                    <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Click="OnForwardClick">
                        <Path Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" 
                              Fill="#9AA0A6" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <!-- Refresh button -->
                    <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Click="OnRefreshClick">
                        <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" 
                              Fill="#9AA0A6" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <!-- URL bar -->
                    <TextBox x:Name="UrlBar" 
                             Style="{StaticResource ChromeOSTextBox}"
                             Text="https://www.bing.com"
                             Width="600" 
                             Margin="10,0"
                             KeyDown="OnUrlBarKeyDown" TextChanged="UrlBar_TextChanged" Height="61" RenderTransformOrigin="0.5,0.5">
                        <TextBox.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleX="0"/>
                                <RotateTransform/>
                                <TranslateTransform X="0"/>
                            </TransformGroup>
                        </TextBox.RenderTransform>
                    </TextBox>
                    <!-- Menu button -->
                    <Button Style="{StaticResource IconButtonStyle}" Width="32" Height="32">
                        <Path Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" 
                              Fill="#9AA0A6" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <!-- Bookmarks bar -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeOSButton}" Padding="8,4" Margin="4,0" FontSize="12" Click="OnGoogleClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Google" Foreground="#E8EAED"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChromeOSButton}" Padding="8,4" Margin="4,0" FontSize="12" Click="OnYouTubeClick">
                        <TextBlock Text="YouTube" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource ChromeOSButton}" Padding="8,4" Margin="4,0" FontSize="12" Click="OnGitHubClick">
                        <TextBlock Text="GitHub" Foreground="#E8EAED"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="WebView" Source="https://www.google.com"/>
    </DockPanel>
</UserControl>
