<UserControl x:Class="ChromeOS.Apps.PlayStoreApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#292A2D">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#35363A" Height="60">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8">
                    <TextBlock Text="Google Play" Foreground="#E8EAED" FontSize="20" FontWeight="Light"/>
                    <TextBox Style="{StaticResource ChromeOSTextBox}" Width="400" Margin="30,0" 
                             Text="Search apps, games, movies..." Foreground="{StaticResource ChromeOSTextSecondary}"
                             GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="16,0">
                    <Button Style="{StaticResource ChromeOSButton}" Padding="12,4" Margin="4,0" FontSize="12">
                        <TextBlock Text="Games" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource ChromeOSButton}" Padding="12,4" Margin="4,0" FontSize="12">
                        <TextBlock Text="Apps" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource ChromeOSButton}" Padding="12,4" Margin="4,0" FontSize="12">
                        <TextBlock Text="Movies" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource ChromeOSButton}" Padding="12,4" Margin="4,0" FontSize="12">
                        <TextBlock Text="Books" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource ChromeOSButton}" Padding="12,4" Margin="4,0" FontSize="12">
                        <TextBlock Text="Kids" Foreground="#E8EAED"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- Featured apps -->
                <TextBlock Text="Featured" Foreground="#E8EAED" FontSize="18" Margin="0,0,0,12"/>
                <ItemsControl x:Name="FeaturedApps">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Height="200" Background="#35363A" CornerRadius="12" Margin="6" 
                                    MouseLeftButtonDown="OnAppClick" Cursor="Hand">
                                <StackPanel Margin="12">
                                    <Border Width="60" Height="60" CornerRadius="12" Background="{Binding IconColor}">
                                        <TextBlock Text="{Binding Icon}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="#E8EAED" FontSize="13" Margin="0,8,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Foreground="#9AA0A6" FontSize="11"/>
                                    <TextBlock Text="{Binding Rating}" Foreground="#8AB4F8" FontSize="11" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
