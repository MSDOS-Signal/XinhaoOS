<UserControl x:Class="ChromeOS.Apps.MusicApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="#1E1E1E">
        <!-- Now Playing Header -->
        <Border DockPanel.Dock="Top" Background="#292A2D" Height="60">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎵" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Now Playing" Foreground="#E8EAED" FontSize="16" FontWeight="Medium"/>
                        <TextBlock Text="ChromeOS Music Player" Foreground="#9AA0A6" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ChromeOSButton}" Padding="12,8" Click="OnPlaylistClick">
                    <TextBlock Text="📋 Playlists" Foreground="#E8EAED" FontSize="13"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <DockPanel>
            <!-- Sidebar -->
            <Border DockPanel.Dock="Left" Background="#292A2D" Width="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Library" Foreground="#8AB4F8" FontSize="13" FontWeight="Medium" Margin="8,8,0,4"/>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnAllSongsClick" Background="#3C3D40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎶" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="All Songs" Foreground="#E8EAED" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnFavoritesClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❤️" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Favorites" Foreground="#E8EAED" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnRecentClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕐" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Recently Played" Foreground="#E8EAED" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        
                        <Separator Margin="0,8" Background="#5F6368"/>
                        
                        <TextBlock Text="Playlists" Foreground="#8AB4F8" FontSize="13" FontWeight="Medium" Margin="8,8,0,4"/>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎸" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Rock Hits" Foreground="#E8EAED" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎹" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Chill Vibes" Foreground="#E8EAED" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏃" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Workout" Foreground="#E8EAED" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Padding="12,8" Margin="0,2" HorizontalContentAlignment="Left" Click="OnCreatePlaylistClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Create Playlist" Foreground="#8AB4F8" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Song List -->
            <ScrollViewer x:Name="SongListScroll" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel x:Name="SongList"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Player Controls -->
        <Border DockPanel.Dock="Bottom" Background="#35363A" Height="80">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                
                <!-- Current Song Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="56" Height="56" Background="#5F6368" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock x:Name="AlbumArt" Text="🎵" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentSongTitle" Text="Select a song" Foreground="#E8EAED" FontSize="14" FontWeight="Medium"/>
                        <TextBlock x:Name="CurrentSongArtist" Text="ChromeOS Music" Foreground="#9AA0A6" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Playback Controls -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Button Style="{StaticResource ChromeOSButton}" Width="36" Height="36" Click="OnShuffleClick" ToolTip="Shuffle">
                            <TextBlock Text="�" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Width="36" Height="36" Margin="12,0" Click="OnPreviousClick" ToolTip="Previous">
                            <TextBlock Text="⏮" FontSize="18"/>
                        </Button>
                        <Button x:Name="PlayPauseBtn" Style="{StaticResource ChromeOSButton}" Width="44" Height="44" Click="OnPlayPauseClick" Background="#8AB4F8">
                            <TextBlock x:Name="PlayPauseIcon" Text="▶️" FontSize="22"/>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Width="36" Height="36" Margin="12,0" Click="OnNextClick" ToolTip="Next">
                            <TextBlock Text="⏭" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource ChromeOSButton}" Width="36" Height="36" Click="OnRepeatClick" ToolTip="Repeat">
                            <TextBlock x:Name="RepeatIcon" Text="🔁" FontSize="16"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="#9AA0A6" FontSize="11" VerticalAlignment="Center"/>
                        <Slider x:Name="ProgressSlider" Width="300" Margin="8,0" Minimum="0" Maximum="100" Value="0"
                                Background="#5F6368" Foreground="#8AB4F8"
                                ValueChanged="OnProgressChanged"/>
                        <TextBlock x:Name="TotalTimeText" Text="3:45" Foreground="#9AA0A6" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Volume Control -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeOSButton}" Width="32" Height="32" Click="OnMuteClick">
                        <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="16"/>
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="100" Margin="8,0" Minimum="0" Maximum="100" Value="80"
                            Background="#5F6368" Foreground="#81C995"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
