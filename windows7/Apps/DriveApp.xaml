<UserControl x:Class="ChromeOS.Apps.DriveApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#292A2D">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="☁" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#8AB4F8"/>
            <TextBlock Text="云端硬盘" FontSize="28" FontWeight="SemiBold" Foreground="#E8EAED"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="即将上线" FontSize="14" Foreground="#9AA0A6"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <TextBlock Text="在这里你将能够：" FontSize="14" Foreground="#E8EAED" Margin="0,0,0,12"/>
            <StackPanel Margin="20,0">
                <TextBlock Text="📁 存储和管理文件" FontSize="13" Foreground="#9AA0A6" Margin="0,4"/>
                <TextBlock Text="📤 上传和下载文件" FontSize="13" Foreground="#9AA0A6" Margin="0,4"/>
                <TextBlock Text="🔗 共享和协作" FontSize="13" Foreground="#9AA0A6" Margin="0,4"/>
                <TextBlock Text="🔄 多设备同步" FontSize="13" Foreground="#9AA0A6" Margin="0,4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
