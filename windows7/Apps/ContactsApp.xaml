<UserControl x:Class="ChromeOS.Apps.ContactsApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#292A2D">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#35363A" BorderBrush="#5F6368" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="联系人" FontSize="20" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Column="1" Width="300" HorizontalAlignment="Center"
                         Style="{StaticResource ChromeOSTextBox}"
                         Text="搜索联系人" Foreground="#9AA0A6" FontSize="14"
                         TextChanged="OnSearchTextChanged" GotFocus="OnSearchGotFocus" LostFocus="OnSearchLostFocus" Margin="0,0,0,-4"/>
                <Button Grid.Column="2" Content="+ 添加" Style="{StaticResource ChromeOSButton}"
                        Background="#8AB4F8" Foreground="#202124" FontWeight="SemiBold"
                        Padding="16,10" Click="OnAddContactClick"/>
            </Grid>
        </Border>

        <!-- Contact List -->
        <Border Grid.Row="1" Background="#292A2D">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContactList" Margin="16"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
